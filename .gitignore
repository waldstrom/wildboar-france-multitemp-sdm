*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*
!.env.example

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build and distribution products
build/
dist/
*.egg-info/

# Pipeline-generated directories
exps/
expy/
processed_data/
processed_data_*/
