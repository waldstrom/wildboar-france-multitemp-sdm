.cache/

# Runtime files
*.log
*.aux.xml
*.tmp
*.temp

# Data directory: documentation is the only versioned content
data/**
!data/**/
!data/**/README.md

# Generated model outputs
outputs/**
!outputs/README.md

# Review-package inputs and outputs
review/input/**
!review/input/README.md
review/output/**
!review/output/README.md

